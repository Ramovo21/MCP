NODE_ENV=development
APP_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
GATEWAY_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
# Optional executable connector module URLs, loaded only by deployment administrators.
CONNECTOR_MODULES=
# Optional in development; mandatory for staging/production. Never publish the worker port.
# WORKER_URL=http://127.0.0.1:4100
# WORKER_AUTH_TOKEN=generate-at-least-32-random-characters
WORKER_PORT=4100
WORKER_CONCURRENCY=4
WORKER_TIMEOUT_MS=30000
# Deployment-loaded provider adapters; redirect base must be the public HTTPS gateway in production.
OAUTH_PROVIDER_MODULES=
OAUTH_REDIRECT_BASE=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional deployment module exporting a SecretProvider. Do not load user-provided modules.
SECRET_PROVIDER_MODULE=
# Opt in to local collector; query strings, headers, arguments and results are never exported.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Deployment-admin-only egress exceptions. Empty in production unless explicitly reviewed.
CONNECTOR_PRIVATE_HOSTS=
# TLS-off exceptions for local PostgreSQL only; host must also be in PRIVATE_HOSTS.
CONNECTOR_INSECURE_PG_HOSTS=
# Optional OpenAI-compatible chat endpoint; Playground proposes tools but never auto-executes.
LLM_CHAT_URL=
LLM_MODEL=
LLM_API_KEY=
# Development seed only. Set a unique password before running db:seed.
SEED_EMAIL=developer@omnimcp.local
SEED_PASSWORD=
