NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
GATEWAY_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
# Optional executable connector module URLs, loaded only by deployment administrators.
CONNECTOR_MODULES=
# Deployment-admin-only egress exceptions. Empty in production unless explicitly reviewed.
CONNECTOR_PRIVATE_HOSTS=
# TLS-off exceptions for local PostgreSQL only; host must also be in PRIVATE_HOSTS.
CONNECTOR_INSECURE_PG_HOSTS=
# Optional OpenAI-compatible chat endpoint; Playground proposes tools but never auto-executes.
LLM_CHAT_URL=
LLM_MODEL=
LLM_API_KEY=
# Development seed only. Set a unique password before running db:seed.
SEED_EMAIL=developer@omnimcp.local
SEED_PASSWORD=
